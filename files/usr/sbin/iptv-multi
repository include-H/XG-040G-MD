#!/bin/sh
# 网络布局：lan1（2.5G）作为主 LAN，lan2-4（1G DSA）作为 IPTV 桥接口。
#
# 背景：PPE 硬件 offload 只对 airoha_eth 的物理口（lan1/pon0）有效，
# lan2-4 是 MT7530 的 DSA 口，不进 PPE；正好拿来当 IPTV 口。
#
# 可覆盖：UPLINK=pon0 SVC_VLAN=43 PORTS="lan2 lan3 lan4" /usr/sbin/iptv-multi

set -eu

UPLINK=${UPLINK:-$(uci -q get iptv.config.uplink || echo pon0)}
SVC_VLAN=${SVC_VLAN:-$(uci -q get iptv.config.service_vlan || echo 43)}
PORTS=${PORTS:-"lan2 lan3 lan4"}
SVC=ct-iptv-svc
BR=br-iptv

# 1) 找 br-lan 的 device 段
BRIDX=""
i=0
while uci -q get "network.@device[$i]" >/dev/null 2>&1; do
	[ "$(uci -q get "network.@device[$i].name")" = "br-lan" ] && BRIDX=$i
	i=$((i + 1))
done
[ -n "$BRIDX" ] || BRIDX=0

# 2) 主 LAN 只留 lan1
uci -q delete "network.@device[$BRIDX].ports"
uci add_list "network.@device[$BRIDX].ports=lan1"

# 3) IPTV 业务 VLAN（pon0.<vid>）
uci set network.luci_iptv_service_vlan=device
uci set network.luci_iptv_service_vlan.type=8021q
uci set network.luci_iptv_service_vlan.ifname="$UPLINK"
uci set network.luci_iptv_service_vlan.vid="$SVC_VLAN"
uci set network.luci_iptv_service_vlan.name="$SVC"

# 4) br-iptv：三个 1G 口 + 业务 VLAN
uci set network.luci_iptv_bridge=device
uci set network.luci_iptv_bridge.type=bridge
uci set network.luci_iptv_bridge.name="$BR"
uci set network.luci_iptv_bridge.stp=0
uci set network.luci_iptv_bridge.igmp_snooping=0
uci -q delete network.luci_iptv_bridge.ports
for p in $PORTS; do
	uci add_list "network.luci_iptv_bridge.ports=$p"
done
uci add_list "network.luci_iptv_bridge.ports=$SVC"

uci set network.luci_iptv=interface
uci set network.luci_iptv.proto=none
uci set network.luci_iptv.device="$BR"
uci set network.luci_iptv.auto=1
uci set network.luci_iptv.delegate=0

# 5) 关掉单口版 luci-app-iptv 的自动应用，避免它覆盖成单口
uci set iptv.config.enabled=0

uci commit network
uci commit iptv

# 6) 桥接过滤：只允许 IPTV 口 <-> 业务 VLAN，其余丢弃
nft delete table bridge iptv 2>/dev/null || true
nft add table bridge iptv
nft add chain bridge iptv iptv_forward "{ type filter hook forward priority filter; policy accept; }"
for p in $PORTS; do
	nft add rule bridge iptv iptv_forward iifname "$p" oifname "$SVC" counter accept
	nft add rule bridge iptv iptv_forward iifname "$SVC" oifname "$p" counter accept
done
nft add rule bridge iptv iptv_forward counter drop

# 7) 应用
ubus call network reload >/dev/null 2>&1 || true
